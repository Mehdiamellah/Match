# Variables de la stack Docker locale — copie ce fichier en .env puis ajuste si besoin
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/Mac)

# Postgres (identifiants de DEV local — rien de secret, la base n'est pas exposée sur Internet)
POSTGRES_DB=foot_matchmaking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=footdev2026

# Secret JWT du backend (génère le tien : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change-moi-en-dev
